<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup (Android 11 and below). Only the Room DB and shared prefs are
  backed up; cached working copies of opened documents are deliberately left out.
  Excludes must sit under an included domain, so we whitelist the two domains we
  back up rather than excluding cache paths from domains we never include.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
</full-backup-content>
