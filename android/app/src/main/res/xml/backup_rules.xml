<!-- Room DB (recents/settings/stamps/signatures) is backed up; caches are not. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <exclude domain="file" path="documents/" />
    <exclude domain="external" path="." />
</full-backup-content>
